# ---------------------------------------------------------------------------
# Lifelog — example environment file
#
# Copy to `.env` and edit. `.env` is gitignored and must never be committed.
#
# SECRETS DO NOT BELONG IN THIS FILE. Real API keys go in `secrets/API-KEYS.md`,
# which is gitignored and loaded automatically at startup. Run `npm run keys:init`
# to create it. See secrets/API-KEYS.example.md and docs/security-checklist.md.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- HTTP server -------------------------------------------------------------
PORT=4319
HOST=0.0.0.0
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5319,http://127.0.0.1:5319

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgres://lifelog:lifelog@127.0.0.1:5434/lifelog
TEST_DATABASE_URL=postgres://lifelog:lifelog@127.0.0.1:5434/lifelog_test

# --- AI provider -------------------------------------------------------------
# openrouter = call a hosted model. local = deterministic offline rule engine.
# `auto` uses openrouter when a key is present and falls back to local otherwise.
AI_PROVIDER=auto
AI_MODEL=google/gemma-4-26b-a4b-it:free
# Timeout. Keep short: free-tier queues stall often. After this Lifelog
# answers with the local rule engine (meta.degraded=true).
AI_TIMEOUT_MS=20000
# Timeouts/rate-limits are not retried. An empty model body is retried once
# inside this deadline.
AI_MAX_RETRIES=0
AI_TEMPERATURE=0.1

# OPENROUTER_API_KEY is intentionally NOT listed with a value here.
# Put it in secrets/API-KEYS.md instead.

# Optional attribution headers sent to OpenRouter (not secret).
OPENROUTER_APP_URL=http://localhost:5319
OPENROUTER_APP_TITLE=Lifelog

# --- Limits ------------------------------------------------------------------
MAX_INPUT_CHARS=20000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
